# Copiez ce fichier en .env.local (jamais commité) et remplissez vos propres valeurs.

# Identifiants du compte administrateur créés au premier lancement (npm run seed).
# Choisissez un mot de passe fort : il ne doit apparaître nulle part dans le code.
ADMIN_EMAIL=admin@votredomaine.com
ADMIN_PASSWORD=changez-ce-mot-de-passe

# Clé secrète utilisée pour signer les sessions de connexion admin (JWT).
# Générez-en une avec : openssl rand -base64 48
JWT_SECRET=

# Chemin du fichier de base de données SQLite (par défaut, un fichier local).
DATABASE_PATH=./data/wuta.db

# Numéro de téléphone / WhatsApp affiché sur le site (pied de page, contact).
PUBLIC_CONTACT_PHONE=+227 90 00 00 00
PUBLIC_CONTACT_CITY=Niamey, Niger


# --- Messagerie interne & notifications push ---
# Générez la paire de clés avec : npx web-push generate-vapid-keys
# La clé publique DOIT être préfixée NEXT_PUBLIC_ pour être lisible côté navigateur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BHI64kZS3Vx5b-53xpZHaWYjW9f1B4duF2wnsTTsxtuyjAIndb-zupNhwqzDH52cCSFug8NQbIAho9eEI6FQvts
VAPID_PRIVATE_KEY=gr9gvoFd9Wd8u3mCY-f9rH5HPvccDu21C9DTO51ze5o
# Email de contact requis par le protocole Web Push (visible des navigateurs, jamais des clients).
VAPID_CONTACT_EMAIL=mohamedattahirdiallo@gmail.com